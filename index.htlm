from pathlib import Path

html = r'''<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Reader Reach — Discover Books. Meet Authors. Join the Conversation.</title>
  <meta name="description" content="Reader Reach is a book discovery and reader-author community platform." />

  <style>
    :root{
      --cream:#f7efe4;
      --cream-2:#fffaf3;
      --cream-3:#f0e2d1;
      --brown:#4b2f24;
      --brown-2:#6b4634;
      --brown-3:#8a6348;
      --gold:#c39a58;
      --gold-soft:#ead9b8;
      --ink:#33241d;
      --muted:#806b5d;
      --line:#eadccc;
      --white:#fffdf9;
      --success:#55724d;
      --shadow:0 18px 50px rgba(72,46,31,.10);
      --radius:22px;
    }

    *{box-sizing:border-box;margin:0;padding:0}

    html{scroll-behavior:smooth}

    body{
      font-family:Georgia,"Times New Roman",serif;
      background:var(--cream);
      color:var(--ink);
      line-height:1.6;
    }

    button,input,textarea,select{font:inherit}

    a{color:inherit;text-decoration:none}

    img{max-width:100%;display:block}

    .container{
      width:min(1180px,calc(100% - 36px));
      margin:0 auto;
    }

    .topbar{
      background:var(--brown);
      color:#fff8ef;
      text-align:center;
      padding:9px 18px;
      font-size:13px;
      letter-spacing:.02em;
    }

    header{
      position:sticky;
      top:0;
      z-index:100;
      background:rgba(255,250,243,.96);
      backdrop-filter:blur(12px);
      border-bottom:1px solid var(--line);
    }

    .nav{
      min-height:78px;
      display:flex;
      align-items:center;
      justify-content:space-between;
      gap:24px;
    }

    .brand{
      display:flex;
      align-items:center;
      gap:11px;
      font-weight:700;
      color:var(--brown);
      font-size:25px;
      letter-spacing:.2px;
      white-space:nowrap;
    }

    .brand-mark{
      width:39px;
      height:39px;
      border-radius:12px 12px 12px 5px;
      background:var(--brown);
      color:#fffaf3;
      display:grid;
      place-items:center;
      font-size:19px;
      box-shadow:0 8px 20px rgba(75,47,36,.16);
    }

    .nav-links{
      display:flex;
      align-items:center;
      gap:26px;
      font-size:15px;
      color:#5d4537;
    }

    .nav-links a{
      transition:.2s ease;
    }

    .nav-links a:hover{color:var(--brown-2)}

    .nav-actions{
      display:flex;
      align-items:center;
      gap:10px;
    }

    .icon-btn{
      width:43px;
      height:43px;
      border:1px solid var(--line);
      background:var(--cream-2);
      color:var(--brown);
      border-radius:50%;
      cursor:pointer;
      display:grid;
      place-items:center;
      font-size:18px;
      transition:.2s ease;
    }

    .icon-btn:hover{
      transform:translateY(-2px);
      border-color:#d3b996;
    }

    .btn{
      border:0;
      border-radius:12px;
      padding:12px 18px;
      cursor:pointer;
      font-weight:700;
      transition:.2s ease;
      display:inline-flex;
      align-items:center;
      justify-content:center;
      gap:8px;
    }

    .btn:hover{transform:translateY(-2px)}

    .btn.primary{
      background:var(--brown);
      color:#fffaf3;
      box-shadow:0 10px 22px rgba(75,47,36,.14);
    }

    .btn.soft{
      background:var(--cream-3);
      color:var(--brown);
    }

    .btn.outline{
      background:transparent;
      color:var(--brown);
      border:1px solid #d7c0a7;
    }

    .mobile-toggle{display:none}

    .hero{
      padding:74px 0 64px;
      background:
        radial-gradient(circle at 88% 18%,rgba(195,154,88,.16),transparent 30%),
        linear-gradient(180deg,#fffaf3 0%,#f7efe4 100%);
    }

    .hero-grid{
      display:grid;
      grid-template-columns:1.02fr .98fr;
      gap:56px;
      align-items:center;
    }

    .eyebrow{
      display:inline-flex;
      align-items:center;
      gap:8px;
      color:var(--brown-2);
      font-size:13px;
      font-weight:700;
      letter-spacing:.12em;
      text-transform:uppercase;
      margin-bottom:17px;
    }

    .eyebrow::before{
      content:"";
      width:30px;
      height:1px;
      background:var(--gold);
    }

    h1{
      color:var(--brown);
      font-size:clamp(42px,5vw,70px);
      line-height:1.04;
      letter-spacing:-.035em;
      margin-bottom:22px;
    }

    .hero-copy{
      color:#715b4d;
      font-size:18px;
      max-width:610px;
      margin-bottom:27px;
    }

    .hero-actions{
      display:flex;
      flex-wrap:wrap;
      gap:11px;
    }

    .hero-note{
      margin-top:22px;
      font-size:13px;
      color:var(--muted);
    }

    .hero-visual{
      position:relative;
      min-height:490px;
    }

    .hero-image{
      position:absolute;
      inset:0 0 0 32px;
      border-radius:30px;
      overflow:hidden;
      box-shadow:var(--shadow);
      border:8px solid rgba(255,250,243,.75);
    }

    .hero-image img{
      width:100%;
      height:100%;
      object-fit:cover;
    }

    .hero-card{
      position:absolute;
      left:0;
      bottom:28px;
      width:240px;
      padding:19px;
      background:rgba(255,253,249,.96);
      border:1px solid var(--line);
      border-radius:18px;
      box-shadow:0 16px 36px rgba(72,46,31,.15);
    }

    .hero-card small{
      color:var(--muted);
      display:block;
      margin-bottom:5px;
    }

    .hero-card strong{
      color:var(--brown);
      font-size:18px;
      display:block;
    }

    .section{
      padding:78px 0;
    }

    .section.alt{
      background:#fffaf3;
    }

    .section-head{
      display:flex;
      justify-content:space-between;
      align-items:flex-end;
      gap:24px;
      margin-bottom:27px;
    }

    .section-head h2{
      color:var(--brown);
      font-size:34px;
      line-height:1.15;
      margin-bottom:8px;
    }

    .section-head p{
      color:var(--muted);
      max-width:680px;
    }

    .section-link{
      color:var(--brown-2);
      font-weight:700;
      white-space:nowrap;
    }

    .section-link:hover{text-decoration:underline}

    .trailer-grid,
    .book-grid,
    .author-grid{
      display:grid;
      grid-template-columns:repeat(3,1fr);
      gap:20px;
    }

    .feature-trailer,
    .book-card,
    .author-card{
      background:var(--white);
      border:1px solid var(--line);
      border-radius:var(--radius);
      overflow:hidden;
      box-shadow:0 10px 30px rgba(72,46,31,.06);
    }

    .trailer-media{
      aspect-ratio:16/9;
      background:#33241d;
      position:relative;
    }

    .trailer-media video,
    .trailer-media .trailer-poster{
      width:100%;
      height:100%;
      object-fit:cover;
      display:block;
    }

    .trailer-placeholder{
      width:100%;
      height:100%;
      display:grid;
      place-items:center;
      color:#fff8ef;
      text-align:center;
      padding:20px;
      background:
        radial-gradient(circle at 30% 25%,rgba(195,154,88,.38),transparent 26%),
        linear-gradient(135deg,#4b2f24,#211914);
    }

    .play-badge{
      width:58px;
      height:58px;
      border-radius:50%;
      background:rgba(255,250,243,.95);
      color:var(--brown);
      display:grid;
      place-items:center;
      font-size:20px;
      margin:0 auto 9px;
    }

    .card-body{padding:20px}

    .tag{
      display:inline-flex;
      align-items:center;
      border-radius:999px;
      padding:5px 9px;
      background:var(--gold-soft);
      color:#6a4c25;
      font-size:11px;
      font-weight:700;
      letter-spacing:.04em;
      text-transform:uppercase;
      margin-bottom:10px;
    }

    .card-title{
      color:var(--brown);
      font-size:21px;
      margin-bottom:6px;
      line-height:1.25;
    }

    .card-meta{
      color:var(--muted);
      font-size:13px;
      margin-bottom:12px;
    }

    .card-description{
      color:#6f594b;
      font-size:14px;
      line-height:1.65;
      margin-bottom:16px;
    }

    .card-actions{
      display:flex;
      flex-wrap:wrap;
      gap:8px;
    }

    .card-actions .btn{
      padding:9px 12px;
      font-size:13px;
    }

    .empty-state{
      padding:38px;
      border:1px dashed #d9c5b0;
      border-radius:18px;
      text-align:center;
      color:var(--muted);
      background:rgba(255,253,249,.65);
      grid-column:1/-1;
    }

    .book-cover{
      aspect-ratio:4/5;
      background:#efe0cf;
      overflow:hidden;
    }

    .book-cover img{
      width:100%;
      height:100%;
      object-fit:cover;
    }

    .author-avatar{
      width:86px;
      height:86px;
      border-radius:50%;
      background:#ead9c6;
      display:grid;
      place-items:center;
      margin:22px auto 14px;
      overflow:hidden;
      color:var(--brown);
      font-size:30px;
      font-weight:700;
    }

    .author-avatar img{
      width:100%;
      height:100%;
      object-fit:cover;
    }

    .author-card{text-align:center}

    .author-card .card-body{padding-top:0}

    .author-name{
      color:var(--brown);
      font-size:20px;
      font-weight:700;
    }

    .author-role{
      color:var(--muted);
      font-size:13px;
      margin:3px 0 10px;
    }

    .author-stats{
      display:flex;
      justify-content:center;
      gap:22px;
      margin:14px 0 17px;
    }

    .author-stats strong{
      display:block;
      color:var(--brown);
      font-size:17px;
    }

    .author-stats span{
      color:var(--muted);
      font-size:11px;
    }

    .info-grid{
      display:grid;
      grid-template-columns:repeat(3,1fr);
      gap:20px;
    }

    .info-card{
      background:var(--white);
      border:1px solid var(--line);
      border-radius:18px;
      padding:25px;
    }

    .info-icon{
      width:45px;
      height:45px;
      border-radius:13px;
      background:var(--cream-3);
      color:var(--brown);
      display:grid;
      place-items:center;
      margin-bottom:15px;
      font-size:19px;
    }

    .info-card h3{
      color:var(--brown);
      margin-bottom:7px;
      font-size:20px;
    }

    .info-card p{
      color:var(--muted);
      font-size:14px;
    }

    .about-grid{
      display:grid;
      grid-template-columns:.9fr 1.1fr;
      gap:48px;
      align-items:center;
    }

    .about-panel{
      background:var(--brown);
      color:#fff8ef;
      border-radius:28px;
      padding:38px;
      min-height:330px;
      display:flex;
      flex-direction:column;
      justify-content:center;
    }

    .about-panel h2{
      font-size:38px;
      line-height:1.1;
      margin-bottom:15px;
    }

    .about-panel p{color:#eadfd6}

    .about-copy h2{
      color:var(--brown);
      font-size:34px;
      margin-bottom:14px;
    }

    .about-copy p{
      color:var(--muted);
      margin-bottom:15px;
    }

    .contact-grid{
      display:grid;
      grid-template-columns:.75fr 1.25fr;
      gap:22px;
    }

    .contact-info,
    .contact-form{
      background:var(--white);
      border:1px solid var(--line);
      border-radius:22px;
      padding:28px;
    }

    .contact-info h3,
    .contact-form h3{
      color:var(--brown);
      font-size:24px;
      margin-bottom:8px;
    }

    .contact-info p{
      color:var(--muted);
      margin-bottom:18px;
    }

    .contact-detail{
      padding:13px 0;
      border-bottom:1px solid var(--line);
      color:#624b3d;
      font-size:14px;
    }

    .contact-detail:last-child{border-bottom:0}

    .field{margin-top:15px}

    .field label{
      display:block;
      margin-bottom:6px;
      color:#5a3b2c;
      font-weight:700;
      font-size:13px;
    }

    .field input,
    .field textarea{
      width:100%;
      border:1px solid #dbc8b5;
      border-radius:11px;
      background:#fffdf9;
      color:var(--ink);
      padding:12px 13px;
      outline:none;
    }

    .field textarea{
      min-height:130px;
      resize:vertical;
    }

    .field input:focus,
    .field textarea:focus{
      border-color:#a67850;
      box-shadow:0 0 0 3px rgba(166,120,80,.12);
    }

    .contact-form .btn{margin-top:15px}

    footer{
      background:#3a261e;
      color:#eadfd6;
      padding:42px 0 28px;
    }

    .footer-grid{
      display:grid;
      grid-template-columns:1.4fr .8fr .8fr;
      gap:30px;
    }

    footer h3{
      color:#fff8ef;
      margin-bottom:10px;
      font-size:18px;
    }

    footer p,footer a{
      color:#cdbeb2;
      font-size:13px;
    }

    footer a:hover{color:#fff8ef}

    .footer-links{
      display:grid;
      gap:7px;
    }

    .footer-bottom{
      margin-top:28px;
      padding-top:18px;
      border-top:1px solid rgba(255,255,255,.10);
      color:#bba99c;
      font-size:12px;
    }

    .chat-fab{
      position:fixed;
      right:24px;
      bottom:24px;
      z-index:200;
      width:58px;
      height:58px;
      border:0;
      border-radius:50%;
      background:var(--brown);
      color:#fffaf3;
      cursor:pointer;
      display:grid;
      place-items:center;
      font-size:23px;
      box-shadow:0 15px 32px rgba(54,32,22,.25);
    }

    .chat-panel{
      position:fixed;
      right:24px;
      bottom:92px;
      z-index:201;
      width:min(360px,calc(100vw - 30px));
      background:var(--white);
      border:1px solid var(--line);
      border-radius:20px;
      box-shadow:0 20px 55px rgba(54,32,22,.20);
      overflow:hidden;
      display:none;
    }

    .chat-panel.open{display:block}

    .chat-head{
      background:var(--brown);
      color:#fff8ef;
      padding:17px 18px;
      display:flex;
      justify-content:space-between;
      align-items:center;
    }

    .chat-head strong{font-size:17px}

    .chat-close{
      border:0;
      background:transparent;
      color:#fff8ef;
      font-size:20px;
      cursor:pointer;
    }

    .chat-body{padding:18px}

    .chat-body p{
      color:var(--muted);
      font-size:13px;
      margin-bottom:12px;
    }

    .chat-body .field{margin-top:10px}

    .modal{
      position:fixed;
      inset:0;
      z-index:300;
      background:rgba(43,28,21,.58);
      display:none;
      align-items:center;
      justify-content:center;
      padding:18px;
    }

    .modal.open{display:flex}

    .modal-card{
      width:min(720px,100%);
      max-height:90vh;
      overflow:auto;
      background:var(--white);
      border-radius:22px;
      border:1px solid var(--line);
      box-shadow:0 24px 80px rgba(0,0,0,.25);
      padding:28px;
      position:relative;
    }

    .modal-close{
      position:absolute;
      right:17px;
      top:15px;
      width:38px;
      height:38px;
      border-radius:50%;
      border:1px solid var(--line);
      background:var(--cream-2);
      color:var(--brown);
      cursor:pointer;
    }

    .modal-card h2{
      color:var(--brown);
      margin-bottom:8px;
      padding-right:45px;
    }

    .modal-card p{
      color:var(--muted);
    }

    .author-preview{
      display:grid;
      grid-template-columns:110px 1fr;
      gap:22px;
      margin-top:22px;
      align-items:start;
    }

    .author-preview-avatar{
      width:110px;
      height:110px;
      border-radius:50%;
      overflow:hidden;
      background:var(--cream-3);
      display:grid;
      place-items:center;
      color:var(--brown);
      font-size:38px;
      font-weight:700;
    }

    .author-preview-avatar img{
      width:100%;
      height:100%;
      object-fit:cover;
    }

    .profile-stats{
      display:flex;
      gap:22px;
      margin-top:14px;
    }

    .profile-stats strong{
      display:block;
      color:var(--brown);
      font-size:18px;
    }

    .profile-stats span{
      color:var(--muted);
      font-size:12px;
    }

    .toast{
      position:fixed;
      left:50%;
      bottom:22px;
      transform:translate(-50%,20px);
      background:var(--brown);
      color:#fffaf3;
      padding:12px 17px;
      border-radius:11px;
      box-shadow:0 10px 30px rgba(0,0,0,.2);
      opacity:0;
      pointer-events:none;
      transition:.25s ease;
      z-index:500;
      max-width:calc(100% - 30px);
      text-align:center;
      font-size:13px;
    }

    .toast.show{
      opacity:1;
      transform:translate(-50%,0);
    }

    .hidden{display:none !important}

    @media(max-width:980px){
      .nav-links{display:none}
      .mobile-toggle{display:grid}
      .nav-links.open{
        display:flex;
        position:absolute;
        left:18px;
        right:18px;
        top:75px;
        background:var(--cream-2);
        border:1px solid var(--line);
        border-radius:16px;
        padding:16px;
        box-shadow:var(--shadow);
        flex-direction:column;
        align-items:flex-start;
      }

      .hero-grid,
      .about-grid,
      .contact-grid{
        grid-template-columns:1fr;
      }

      .hero-visual{min-height:420px}
      .trailer-grid,.book-grid,.author-grid{grid-template-columns:repeat(2,1fr)}
      .info-grid{grid-template-columns:1fr 1fr}
      .footer-grid{grid-template-columns:1fr 1fr}
    }

    @media(max-width:650px){
      .container{width:min(100% - 24px,1180px)}
      .topbar{font-size:12px}
      .nav{min-height:70px}
      .brand{font-size:21px}
      .brand-mark{width:35px;height:35px}
      .nav-actions .btn{display:none}
      .hero{padding:52px 0 45px}
      h1{font-size:43px}
      .hero-copy{font-size:16px}
      .hero-visual{min-height:340px}
      .hero-image{inset:0}
      .hero-card{left:12px;bottom:15px;width:220px}
      .section{padding:58px 0}
      .section-head{align-items:flex-start;flex-direction:column}
      .section-head h2{font-size:29px}
      .trailer-grid,.book-grid,.author-grid,.info-grid,.footer-grid{
        grid-template-columns:1fr;
      }
      .author-preview{grid-template-columns:1fr}
      .profile-stats{flex-wrap:wrap}
      .chat-fab{right:15px;bottom:15px}
      .chat-panel{right:15px;bottom:84px}
    }
  </style>
</head>

<body>

  <div class="topbar">
    Discover books, meet authors, and join meaningful conversations.
  </div>

  <header>
    <div class="container nav">
      <a class="brand" href="#home" aria-label="Reader Reach home">
        <span class="brand-mark">R</span>
        <span>Reader Reach</span>
      </a>

      <nav id="navLinks" class="nav-links" aria-label="Main navigation">
        <a href="#authors">Authors</a>
        <a href="#featured">Featured</a>
        <a href="#about">About Us</a>
        <a href="#contact">Contact Us</a>
      </nav>

      <div class="nav-actions">
        <button
          id="contactIcon"
          class="icon-btn"
          type="button"
          aria-label="Open contact form"
          title="Contact Reader Reach"
        >✉</button>

        <a class="btn primary" href="auth.html">Sign In</a>

        <button
          id="mobileToggle"
          class="icon-btn mobile-toggle"
          type="button"
          aria-label="Open menu"
        >☰</button>
      </div>
    </div>
  </header>

  <main id="home">

    <!-- HERO -->
    <section class="hero">
      <div class="container hero-grid">
        <div>
          <div class="eyebrow">A home for books and conversations</div>

          <h1>Discover stories. Meet the people behind them.</h1>

          <p class="hero-copy">
            Reader Reach connects readers with approved authors, featured books,
            book trailers, scheduled conversations, and a growing community built
            around reading.
          </p>

          <div class="hero-actions">
            <a class="btn primary" href="#featured">Explore Featured Books</a>
            <a class="btn outline" href="#authors">Meet Our Authors</a>
          </div>

          <p class="hero-note">
            Public browsing is available without signing in. Sign in to access
            reader, author, moderator, or administrator features.
          </p>
        </div>

        <div class="hero-visual">
          <div class="hero-image">
            <img
              src="https://images.unsplash.com/photo-1544947950-fa07a98d237f?auto=format&fit=crop&w=1800&q=85"
              alt="Open book"
            />
          </div>

          <div class="hero-card">
            <small>Reader Reach</small>
            <strong>Books are only the beginning.</strong>
            <p class="muted" style="font-size:13px;margin-top:7px;">
              Discover authors, follow their work and join the conversation.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- UPCOMING FEATURE TRAILERS: FIRST ROW -->
    <section id="upcoming" class="section alt">
      <div class="container">
        <div class="section-head">
          <div>
            <h2>Upcoming Features</h2>
            <p>
              Book trailers selected for an upcoming feature. When the Admin
              turns a trailer on for homepage display, it appears here.
            </p>
          </div>
          <a class="section-link" href="#featured">See Featured Books ↓</a>
        </div>

        <div id="upcomingTrailerGrid" class="trailer-grid">
          <div class="empty-state">
            Upcoming book trailers will appear here when an approved book has
            been scheduled and the Admin enables its homepage trailer.
          </div>
        </div>
      </div>
    </section>

    <!-- FEATURED BOOKS: SECOND ROW -->
    <section id="featured" class="section">
      <div class="container">
        <div class="section-head">
          <div>
            <h2>Featured Books</h2>
            <p>
              Books selected by the Admin for the Reader Reach Featured collection.
              Featured status is separate from approval and scheduling.
            </p>
          </div>
          <a class="section-link" href="#authors">Meet the Authors →</a>
        </div>

        <div id="featuredBookGrid" class="book-grid">
          <div class="empty-state">
            Featured books will appear here when the Admin selects them.
          </div>
        </div>
      </div>
    </section>

    <!-- AUTHORS -->
    <section id="authors" class="section alt">
      <div class="container">
        <div class="section-head">
          <div>
            <h2>Authors</h2>
            <p>
              Meet approved Reader Reach authors and explore their books,
              biographies, followers and public profiles.
            </p>
          </div>
        </div>

        <div id="authorGrid" class="author-grid">
          <div class="empty-state">
            Approved authors will appear here after Admin approval.
          </div>
        </div>
      </div>
    </section>

    <!-- PLATFORM -->
    <section class="section">
      <div class="container">
        <div class="section-head">
          <div>
            <h2>How Reader Reach Works</h2>
            <p>
              A connected space for discovery, publishing relationships,
              scheduling and reader participation.
            </p>
          </div>
        </div>

        <div class="info-grid">
          <article class="info-card">
            <div class="info-icon">◈</div>
            <h3>Discover Books</h3>
            <p>
              Browse approved books, featured selections and upcoming book
              trailers without needing an account.
            </p>
          </article>

          <article class="info-card">
            <div class="info-icon">✦</div>
            <h3>Meet Authors</h3>
            <p>
              Open an author profile from a book to see their biography,
              books, ratings, followers and following.
            </p>
          </article>

          <article class="info-card">
            <div class="info-icon">◌</div>
            <h3>Join Conversations</h3>
            <p>
              Readers can follow authors, receive notifications and join
              authorized book discussions.
            </p>
          </article>
        </div>
      </div>
    </section>

    <!-- ABOUT -->
    <section id="about" class="section alt">
      <div class="container about-grid">
        <div class="about-panel">
          <div class="eyebrow" style="color:#ead9b8;">About Reader Reach</div>
          <h2>Where books create connections.</h2>
          <p>
            Reader Reach is designed to bring books, authors, readers and
            conversations together in one trusted platform.
          </p>
        </div>

        <div class="about-copy">
          <h2>A platform built around real participation.</h2>
          <p>
            Authors can build their public profile and submit multiple books
            for review. Approved books can become featured, scheduled and
            discussed.
          </p>
          <p>
            Readers can discover books, follow authors and take part in
            authorized discussions. Moderators coordinate approved features
            and communication, while Admin controls approvals and platform
            settings.
          </p>
          <a class="btn soft" href="auth.html">Create an Account</a>
        </div>
      </div>
    </section>

    <!-- CONTACT -->
    <section id="contact" class="section">
      <div class="container">
        <div class="section-head">
          <div>
            <h2>Contact Us</h2>
            <p>
              Send a message to the Reader Reach team. Contact messages are
              routed into the Moderator Messages inbox.
            </p>
          </div>
        </div>

        <div class="contact-grid">
          <div class="contact-info">
            <h3>We are listening.</h3>
            <p>
              Use the contact form for questions, support, feedback or general
              enquiries about Reader Reach.
            </p>

            <div class="contact-detail">
              <strong>Platform</strong><br />
              Reader Reach
            </div>

            <div class="contact-detail">
              <strong>Message destination</strong><br />
              Moderator Messages
            </div>

            <div class="contact-detail">
              <strong>Response</strong><br />
              A moderator can respond from the connected messaging system.
            </div>
          </div>

          <form id="contactForm" class="contact-form">
            <h3>Send a message</h3>
            <p class="muted">
              Your message will be saved and routed to the Moderator Messages inbox.
            </p>

            <div class="field">
              <label for="contactName">Name</label>
              <input id="contactName" type="text" required placeholder="Your name" />
            </div>

            <div class="field">
              <label for="contactEmail">Email Address</label>
              <input id="contactEmail" type="email" required placeholder="you@example.com" />
            </div>

            <div class="field">
              <label for="contactSubject">Subject</label>
              <input id="contactSubject" type="text" required placeholder="How can we help?" />
            </div>

            <div class="field">
              <label for="contactMessage">Message</label>
              <textarea id="contactMessage" required placeholder="Write your message"></textarea>
            </div>

            <button class="btn primary" type="submit">
              Send Message
            </button>
          </form>
        </div>
      </div>
    </section>

  </main>

  <footer>
    <div class="container footer-grid">
      <div>
        <h3>Reader Reach</h3>
        <p>
          Discover books, meet authors and join meaningful conversations.
        </p>
      </div>

      <div>
        <h3>Explore</h3>
        <div class="footer-links">
          <a href="#authors">Authors</a>
          <a href="#upcoming">Upcoming Features</a>
          <a href="#featured">Featured Books</a>
          <a href="#about">About Us</a>
        </div>
      </div>

      <div>
        <h3>Need Help?</h3>
        <div class="footer-links">
          <a href="#contact">Contact Us</a>
          <a href="auth.html">Sign In</a>
        </div>
      </div>
    </div>

    <div class="container footer-bottom">
      © <span id="footerYear"></span> Reader Reach. All rights reserved.
    </div>
  </footer>

  <!-- FLOATING LIVE CHAT -->
  <button
    id="chatFab"
    class="chat-fab"
    type="button"
    aria-label="Open live chat"
    title="Live Chat"
  >💬</button>

  <section id="chatPanel" class="chat-panel" aria-label="Reader Reach live chat">
    <div class="chat-head">
      <strong>Reader Reach Live Chat</strong>
      <button id="chatClose" class="chat-close" type="button" aria-label="Close chat">×</button>
    </div>

    <div class="chat-body">
      <p>
        Leave a message and it will appear in the Moderator Messages inbox.
      </p>

      <form id="chatForm">
        <div class="field">
          <label for="chatName">Name</label>
          <input id="chatName" type="text" required placeholder="Your name" />
        </div>

        <div class="field">
          <label for="chatEmail">Email Address</label>
          <input id="chatEmail" type="email" required placeholder="you@example.com" />
        </div>

        <div class="field">
          <label for="chatMessage">Message</label>
          <textarea id="chatMessage" required placeholder="How can we help?"></textarea>
        </div>

        <button class="btn primary" type="submit" style="width:100%;margin-top:12px;">
          Start Chat
        </button>
      </form>
    </div>
  </section>

  <!-- AUTHOR PROFILE PREVIEW -->
  <div id="authorModal" class="modal" aria-hidden="true">
    <div class="modal-card">
      <button id="authorModalClose" class="modal-close" type="button" aria-label="Close">×</button>

      <h2 id="authorModalName">Author Profile</h2>
      <p id="authorModalBio">Loading author information...</p>

      <div class="author-preview">
        <div id="authorModalAvatar" class="author-preview-avatar">A</div>

        <div>
          <div class="profile-stats">
            <div>
              <strong id="authorBookCount">0</strong>
              <span>Books</span>
            </div>
            <div>
              <strong id="authorRating">—</strong>
              <span>Rating</span>
            </div>
            <div>
              <strong id="authorFollowerCount">0</strong>
              <span>Followers</span>
            </div>
            <div>
              <strong id="authorFollowingCount">0</strong>
              <span>Following</span>
            </div>
          </div>

          <div class="card-actions" style="margin-top:18px;">
            <button id="viewAuthorProfileBtn" class="btn primary" type="button">
              View Author Profile
            </button>
            <button id="followAuthorBtn" class="btn soft" type="button">
              Follow Author
            </button>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div id="toast" class="toast"></div>

  <script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>

  <script>
    const SUPABASE_URL = 'https://bublmnfhyyrefcdkloak.supabase.co';
    const SUPABASE_PUBLISHABLE_KEY = 'sb_publishable_-bqN7xBRoMoOsueGOmA0sw_0n6GbXtY';

    const supabaseClient = window.supabase.createClient(
      SUPABASE_URL,
      SUPABASE_PUBLISHABLE_KEY,
      {
        auth:{
          storageKey:'reader-reach-auth',
          persistSession:true,
          autoRefreshToken:true,
          detectSessionInUrl:true,
          storage:window.localStorage
        }
      }
    );

    const state = {
      approvedBooks:[],
      approvedAuthors:[],
      featuredBooks:[],
      upcomingTrailers:[],
      currentAuthor:null
    };

    const $ = (id) => document.getElementById(id);

    function escapeHtml(value){
      return String(value ?? '')
        .replace(/&/g,'&amp;')
        .replace(/</g,'&lt;')
        .replace(/>/g,'&gt;')
        .replace(/"/g,'&quot;')
        .replace(/'/g,'&#039;');
    }

    function initials(name){
      const text = String(name || 'Author').trim();
      return text
        .split(/\s+/)
        .slice(0,2)
        .map(part => part.charAt(0).toUpperCase())
        .join('') || 'A';
    }

    function showToast(message){
      const toast = $('toast');
      toast.textContent = message;
      toast.classList.add('show');
      setTimeout(() => toast.classList.remove('show'),3500);
    }

    function publicStorageUrl(path){
      return path || '';
    }

    function authorProfileUrl(authorId){
      /*
        The permanent author profile page will be:
        author-profile.html?id=<author-id>
      */
      return `author-profile.html?id=${encodeURIComponent(authorId)}`;
    }

    function renderEmpty(target,message){
      target.innerHTML = `<div class="empty-state">${escapeHtml(message)}</div>`;
    }

    async function loadApprovedAuthors(){
      const {data,error} = await supabaseClient
        .from('authors')
        .select('id,profile_id,author_name,bio,status,created_at')
        .eq('status','approved')
        .order('author_name',{ascending:true});

      if(error){
        console.error('Approved authors:',error);
        renderEmpty($('authorGrid'),'Authors are temporarily unavailable.');
        return;
      }

      state.approvedAuthors = data || [];
      renderAuthors();
    }

    async function loadApprovedBooks(){
      const {data,error} = await supabaseClient
        .from('books')
        .select('id,author_id,title,description,genre_topic,who_its_for,availability,cover_url,status,created_at')
        .eq('status','approved')
        .order('created_at',{ascending:false});

      if(error){
        console.error('Approved books:',error);
        renderEmpty($('featuredBookGrid'),'Featured books are temporarily unavailable.');
        return;
      }

      state.approvedBooks = data || [];
    }

    async function loadFeaturedBooks(){
      const {data,error} = await supabaseClient
        .from('homepage_featured_books')
        .select('book_id,selected_at')
        .order('selected_at',{ascending:false});

      if(error){
        console.error('Featured books:',error);
        renderEmpty($('featuredBookGrid'),'Featured books are temporarily unavailable.');
        return;
      }

      const bookMap = new Map(
        state.approvedBooks.map(book => [book.id,book])
      );

      state.featuredBooks = (data || [])
        .map(row => bookMap.get(row.book_id))
        .filter(Boolean);

      renderFeaturedBooks();
    }

    async function loadUpcomingTrailers(){
      /*
        Upcoming homepage trailers are controlled by:
        - approved book
        - feature schedule status = scheduled
        - trailer show_on_homepage = true

        This keeps the Admin's trailer switch separate from:
        - book approval
        - homepage Featured selection
        - schedule status
      */

      const {data:schedules,error:scheduleError} = await supabaseClient
        .from('feature_schedules')
        .select('id,book_id,feature_date,feature_time,status,notes')
        .eq('status','scheduled')
        .order('feature_date',{ascending:true})
        .order('feature_time',{ascending:true});

      if(scheduleError){
        console.error('Upcoming schedules:',scheduleError);
        renderEmpty($('upcomingTrailerGrid'),'Upcoming features are temporarily unavailable.');
        return;
      }

      if(!schedules || !schedules.length){
        renderEmpty(
          $('upcomingTrailerGrid'),
          'No upcoming book trailers are currently scheduled.'
        );
        return;
      }

      const bookIds = [...new Set(schedules.map(row => row.book_id))];

      const {data:trailers,error:trailerError} = await supabaseClient
        .from('book_trailers')
        .select('id,book_id,trailer_url,title,description,show_on_homepage')
        .in('book_id',bookIds)
        .eq('show_on_homepage',true);

      if(trailerError){
        console.error('Upcoming trailers:',trailerError);
        renderEmpty($('upcomingTrailerGrid'),'Upcoming trailers are temporarily unavailable.');
        return;
      }

      const trailerMap = new Map(
        (trailers || []).map(trailer => [trailer.book_id,trailer])
      );

      const bookMap = new Map(
        state.approvedBooks.map(book => [book.id,book])
      );

      state.upcomingTrailers = schedules
        .map(schedule => {
          const book = bookMap.get(schedule.book_id);
          const trailer = trailerMap.get(schedule.book_id);
          if(!book || !trailer) return null;
          return {schedule,book,trailer};
        })
        .filter(Boolean);

      renderUpcomingTrailers();
    }

    function renderUpcomingTrailers(){
      const target = $('upcomingTrailerGrid');

      if(!state.upcomingTrailers.length){
        renderEmpty(
          target,
          'No upcoming book trailers are currently available for homepage display.'
        );
        return;
      }

      target.innerHTML = state.upcomingTrailers.map(item => {
        const {book,trailer,schedule} = item;
        const author = state.approvedAuthors.find(
          a => a.id === book.author_id
        );

        const authorName = author?.author_name || 'Approved Author';

        return `
          <article class="feature-trailer">
            <div class="trailer-media">
              ${
                trailer.trailer_url
                ? `
                  <video
                    controls
                    preload="metadata"
                    src="${escapeHtml(publicStorageUrl(trailer.trailer_url))}"
                    aria-label="Trailer for ${escapeHtml(book.title)}"
                  ></video>
                `
                : `
                  <div class="trailer-placeholder">
                    <div>
                      <div class="play-badge">▶</div>
                      <strong>Trailer coming soon</strong>
                    </div>
                  </div>
                `
              }
            </div>

            <div class="card-body">
              <span class="tag">Upcoming Feature</span>
              <h3 class="card-title">${escapeHtml(book.title)}</h3>
              <div class="card-meta">
                By ${escapeHtml(authorName)}
                · ${escapeHtml(schedule.feature_date || 'Scheduled')}
                ${schedule.feature_time ? ` · ${escapeHtml(schedule.feature_time)}` : ''}
              </div>

              <p class="card-description">
                ${escapeHtml(
                  trailer.description ||
                  book.description ||
                  'Explore this upcoming Reader Reach feature.'
                )}
              </p>

              <div class="card-actions">
                <button
                  class="btn soft"
                  type="button"
                  onclick="openAuthorPreview('${escapeHtml(book.author_id)}')"
                >
                  View Author Profile
                </button>
              </div>
            </div>
          </article>
        `;
      }).join('');
    }

    function renderFeaturedBooks(){
      const target = $('featuredBookGrid');

      if(!state.featuredBooks.length){
        renderEmpty(
          target,
          'No books have been selected for Featured Books yet.'
        );
        return;
      }

      target.innerHTML = state.featuredBooks.map(book => {
        const author = state.approvedAuthors.find(
          a => a.id === book.author_id
        );

        return `
          <article class="book-card">
            <div class="book-cover">
              ${
                book.cover_url
                ? `<img src="${escapeHtml(publicStorageUrl(book.cover_url))}" alt="${escapeHtml(book.title)} book cover" />`
                : `
                  <div style="height:100%;display:grid;place-items:center;padding:24px;color:#806b5d;text-align:center;">
                    No cover image available
                  </div>
                `
              }
            </div>

            <div class="card-body">
              <span class="tag">Featured Book</span>
              <h3 class="card-title">${escapeHtml(book.title)}</h3>

              <div class="card-meta">
                By ${escapeHtml(author?.author_name || 'Approved Author')}
              </div>

              <p class="card-description">
                ${escapeHtml(
                  book.description ||
                  'Discover this featured Reader Reach book.'
                )}
              </p>

              <div class="card-actions">
                <button
                  class="btn primary"
                  type="button"
                  onclick="openBookDetails('${escapeHtml(book.id)}')"
                >
                  View Book
                </button>

                <button
                  class="btn soft"
                  type="button"
                  onclick="openAuthorPreview('${escapeHtml(book.author_id)}')"
                >
                  View Author Profile
                </button>
              </div>
            </div>
          </article>
        `;
      }).join('');
    }

    function renderAuthors(){
      const target = $('authorGrid');

      if(!state.approvedAuthors.length){
        renderEmpty(
          target,
          'No approved authors are currently available.'
        );
        return;
      }

      target.innerHTML = state.approvedAuthors.map(author => `
        <article class="author-card">
          <div class="author-avatar">
            <span>${escapeHtml(initials(author.author_name))}</span>
          </div>

          <div class="card-body">
            <div class="author-name">${escapeHtml(author.author_name)}</div>
            <div class="author-role">Author · Writer</div>

            <p class="card-description">
              ${escapeHtml(
                author.bio ||
                'This author has not added a public biography yet.'
              )}
            </p>

            <div class="author-stats">
              <div>
                <strong>—</strong>
                <span>Books</span>
              </div>
              <div>
                <strong>—</strong>
                <span>Rating</span>
              </div>
              <div>
                <strong>—</strong>
                <span>Followers</span>
              </div>
            </div>

            <div class="card-actions" style="justify-content:center;">
              <button
                class="btn primary"
                type="button"
                onclick="openAuthorPreview('${escapeHtml(author.id)}')"
              >
                View Author Profile
              </button>
            </div>
          </div>
        </article>
      `).join('');
    }

    async function openAuthorPreview(authorId){
      const author = state.approvedAuthors.find(
        item => item.id === authorId
      );

      if(!author){
        showToast('Author profile could not be found.');
        return;
      }

      state.currentAuthor = author;

      $('authorModalName').textContent = author.author_name || 'Author';
      $('authorModalBio').textContent =
        author.bio ||
        'This author has not added a public biography yet.';

      $('authorModalAvatar').textContent =
        initials(author.author_name);

      const {count:bookCount} = await supabaseClient
        .from('books')
        .select('id',{count:'exact',head:true})
        .eq('author_id',author.id)
        .eq('status','approved');

      /*
        Follower counts will use the follower relationship table
        once that table is added to the database. Until then,
        the public profile safely shows a neutral placeholder
        rather than inventing a number.
      */
      $('authorBookCount').textContent = bookCount ?? 0;
      $('authorRating').textContent = '—';
      $('authorFollowerCount').textContent = '—';
      $('authorFollowingCount').textContent = '—';

      $('viewAuthorProfileBtn').onclick = () => {
        window.location.href = authorProfileUrl(author.id);
      };

      $('followAuthorBtn').onclick = async () => {
        const {
          data:{user}
        } = await supabaseClient.auth.getUser();

        if(!user){
          window.location.href = 'auth.html';
          return;
        }

        showToast(
          'Follow is available from the connected author profile.'
        );
        window.location.href = authorProfileUrl(author.id);
      };

      $('authorModal').classList.add('open');
      $('authorModal').setAttribute('aria-hidden','false');
    }

    function closeAuthorPreview(){
      $('authorModal').classList.remove('open');
      $('authorModal').setAttribute('aria-hidden','true');
    }

    function openBookDetails(bookId){
      /*
        The connected book detail page will use:
        book.html?id=<book-id>
      */
      window.location.href =
        `book.html?id=${encodeURIComponent(bookId)}`;
    }

    async function submitContactMessage(event){
      event.preventDefault();

      const name = $('contactName').value.trim();
      const email = $('contactEmail').value.trim();
      const subject = $('contactSubject').value.trim();
      const message = $('contactMessage').value.trim();

      if(!name || !email || !subject || !message){
        showToast('Please complete every contact field.');
        return;
      }

      /*
        The final connected contact_messages table will receive this
        submission and route it into the Moderator Messages inbox.
      */
      const {error} = await supabaseClient
        .from('contact_messages')
        .insert({
          name,
          email,
          subject,
          message
        });

      if(error){
        console.error('Contact message:',error);

        showToast(
          'The contact system is not connected yet. The message was not sent.'
        );

        return;
      }

      $('contactForm').reset();
      showToast('Your message has been sent to Reader Reach.');
    }

    async function submitLiveChat(event){
      event.preventDefault();

      const name = $('chatName').value.trim();
      const email = $('chatEmail').value.trim();
      const message = $('chatMessage').value.trim();

      if(!name || !email || !message){
        showToast('Please complete your name, email and message.');
        return;
      }

      /*
        The final connected live-chat system will use:
        live_chat_conversations
        live_chat_messages

        The insert below is intentionally guarded so the public page
        never pretends a message was delivered when the backend table
        does not exist.
      */
      showToast(
        'Live Chat will connect to the Moderator Messages inbox when the chat backend is enabled.'
      );

      $('chatForm').reset();
    }

    function setupNavigation(){
      $('mobileToggle').addEventListener('click',() => {
        $('navLinks').classList.toggle('open');
      });

      document.querySelectorAll('#navLinks a').forEach(link => {
        link.addEventListener('click',() => {
          $('navLinks').classList.remove('open');
        });
      });

      $('contactIcon').addEventListener('click',() => {
        document.querySelector('#contact').scrollIntoView({
          behavior:'smooth'
        });
      });
    }

    function setupChat(){
      $('chatFab').addEventListener('click',() => {
        $('chatPanel').classList.toggle('open');
      });

      $('chatClose').addEventListener('click',() => {
        $('chatPanel').classList.remove('open');
      });
    }

    function setupModals(){
      $('authorModalClose').addEventListener(
        'click',
        closeAuthorPreview
      );

      $('authorModal').addEventListener('click',(event) => {
        if(event.target === $('authorModal')){
          closeAuthorPreview();
        }
      });
    }

    async function initialize(){
      $('footerYear').textContent = new Date().getFullYear();

      setupNavigation();
      setupChat();
      setupModals();

      $('contactForm').addEventListener(
        'submit',
        submitContactMessage
      );

      $('chatForm').addEventListener(
        'submit',
        submitLiveChat
      );

      await loadApprovedAuthors();
      await loadApprovedBooks();
      await loadFeaturedBooks();
      await loadUpcomingTrailers();
    }

    window.openAuthorPreview = openAuthorPreview;
    window.openBookDetails = openBookDetails;

    initialize();
  </script>
</body>
</html>
'''

